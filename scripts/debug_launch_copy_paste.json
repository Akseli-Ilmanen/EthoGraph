{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/debug_gui.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "python": "C:\\Users\\aksel\\anaconda3\\envs\\ethograph\\python.exe",
            "justMyCode": false,
            "env": {
                "PYTHONFAULTHANDLER": "1",
                "CONDA_DEFAULT_ENV": "ethograph",
                "PYDEVD_USE_SYS_MONITORING": "0",
                "TYPEGUARD_DISABLE_PLUGIN_AUTOLOAD": "1"
            }
        }
    ]
}