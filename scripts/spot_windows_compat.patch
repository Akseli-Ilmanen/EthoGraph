+def load_side_array(side_dir, key, cache, video, stride, what='side arrays'):
+    # ethograph: a per-video (T', d) array on the strided clock -- a teacher's
+    # embedding or the pose block -- loaded once per video
+    if video not in cache:
+        with np.load(os.path.join(side_dir, video + '.npz')) as npz:
+            if int(npz['stride']) != stride:
+                raise ValueError(
+                    '{} for {} are on stride {}, this run uses stride '
+                    '{}'.format(what, video, int(npz['stride']), stride))
+            cache[video] = npz[key].astype(np.float32)
+    return cache[video]
+
+
+def load_side_clip(side_dir, key, cache, video, base_idx, clip_len, stride,
+                   what='side arrays', zero=False):
+    # The clip's frames are base_idx + i * stride, i.e. strided index
+    # base_idx // stride + i; frames past either end of the video are
+    # padding (zeros) in load_frames and masked out here.
+    arr = load_side_array(side_dir, key, cache, video, stride, what)
+    d = arr.shape[1]
+    out = np.zeros((clip_len, d), np.float32)
+    mask = np.zeros(clip_len, bool)
+    if zero:
+        return out, mask
+    start = base_idx // stride
+    for i in range(clip_len):
+        j = start + i
+        if 0 <= j < len(arr):
+            out[i] = arr[j]
+            mask[i] = True
+    return out, mask
+
